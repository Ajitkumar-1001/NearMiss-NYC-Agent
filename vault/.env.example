# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Every entry here should correspond to an adapter registered in
# 04-Architecture/07-Provider-Adapters.md. Add keys as adapters are written --
# the list below is a scaffold, not a requirement.

# --- Model providers ---
# ANTHROPIC_API_KEY=

# --- Vision / video processing ---
# VISION_PROVIDER_API_KEY=

# --- Data feeds (see 03-Research/02-Live-Feeds.md) ---
# FEED_API_KEY=

# --- App ---
# BACKEND_PORT=
# FRONTEND_URL=

# --- Demo ---
# Force the fixture path regardless of provider availability (ADR-001).
# USE_FIXTURES=true
