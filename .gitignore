# OS
.DS_Store
Thumbs.db

# Secrets — never commit .env
.env
.env.*
!.env.example

# Obsidian per-machine state (config below is shared on purpose).
# Anchored under vault/ — these patterns contain a slash, so they resolve
# relative to this file, which now sits at the repo root, not the vault.
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/plugins/*/data.json

# Node
node_modules/
dist/
build/
.next/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Logs
*.log

# Agent tooling scratch state (per-machine, not project content)
.claude-flow/
.claude/

# demo/fixtures/ is deliberately NOT ignored.
# ADR-001 (Deterministic Demo First) makes those fixtures load-bearing.
# Nor are vault/ or tests/ — the vault is the tracked knowledge base and
# tests/ backs every "tests pass" claim. Do not add blanket rules for them.

# Stock SpecKit scaffolding, installed 7 Aug. This project drives SpecKit from
# vault/05-SpecKit/ prompt notes instead; .specify/memory/constitution.md is an
# unfilled template and would be a second, competing constitution.
.specify/
