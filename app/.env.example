# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Every entry here corresponds to something the code actually reads. All of them
# are optional: an absent credential makes the corresponding stage decline and
# the pipeline degrades one rung (ADR-001), it does not fail the request.

# --- Runtime providers (each has a fixture fallback) ---
# Detection. Both are required together; either alone leaves vision unconfigured.
# ROBOFLOW_API_KEY=
# ROBOFLOW_MODEL_ID=

# Historical context enrichment.
# NYC_OPEN_DATA_APP_TOKEN=

# Generated explanation. Without it the deterministic template serves.
# GEMINI_API_KEY=

# --- App ---
# Reported by /health so a deployed revision is identifiable (FR-019).
# Set at deploy time: --set-env-vars GIT_REVISION=$(git rev-parse --short HEAD)
# GIT_REVISION=

# Cloud Run sets this itself; 8080 is the local default (NFR-001).
# PORT=8080

# --- Risk engine (config.py Settings, env_prefix NEARMISS_) ---
# Candidate-conflict threshold, 0-100 (FR-007).
# NEARMISS_ALERT_THRESHOLD=70
# Score at or above which severity is "high".
# NEARMISS_HIGH_SEVERITY_AT=80
# Where the committed fixtures live. Pinned explicitly in the container because
# config.py infers it from the source-tree layout, which pip install breaks.
# NEARMISS_FIXTURE_DIR=
# Deployment label echoed by /health.
# NEARMISS_ENVIRONMENT=local
